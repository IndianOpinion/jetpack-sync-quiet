{
    "name": "indianopinion/jetpack-sync-quiet",
    "description": "WordPress plugin that turns off Jetpack's dedicated-sync loopback requests and keeps sync running on cron.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "jetpack", "sync", "loopback", "mu-plugin", "performance"],
    "homepage": "https://github.com/IndianOpinion/jetpack-sync-quiet",
    "authors": [
        {"name": "Indian Opinion", "email": "hello@indianopinion.org"}
    ],
    "support": {
        "issues": "https://github.com/IndianOpinion/jetpack-sync-quiet/issues",
        "source": "https://github.com/IndianOpinion/jetpack-sync-quiet"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {"IndianOpinion\\JetpackSyncQuiet\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"IndianOpinion\\JetpackSyncQuiet\\Tests\\": "tests/"}
    },
    "scripts": {
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs",
        "check": ["@lint", "@cs", "@stan", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.1.0"}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
